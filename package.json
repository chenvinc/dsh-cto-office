{
  "name": "@swiper1881/dsh-cto-office",
  "version": "0.4.0-alpha.2",
  "description": "CTO 办公室模式：一名 CTO 带六个岗位（架构师、工程师、评审、QA、UI/UX 设计、业务）的 agent 预设集合",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenvinc/dsh-cto-office.git"
  },
  "homepage": "https://github.com/chenvinc/dsh-cto-office#readme",
  "bugs": {
    "url": "https://github.com/chenvinc/dsh-cto-office/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent-presets",
    "cto",
    "multi-agent"
  ],
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./skills/*": "./skills/*",
    "./package.json": "./package.json",
    "./tools": "./tools-plugin.js"
  },
  "files": [
    "cordis.patch.yml",
    "skills",
    "scripts",
    "docs",
    "lib",
    "test",
    "index.js",
    "client.js",
    "README.md",
    "tools-plugin.js",
    "!docs/cto-office-v2.0-汇报.pdf",
    "!docs/cto-office-v2.0-汇报.html",
    "!docs/cto-office-v2.0-汇报-批注.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "unknown",
        "0.2.2-rc.2": "unknown",
        "0.2.2-rc.3": "compatible",
        "0.2.2-rc.4": "compatible",
        "0.2.2-rc.5": "compatible"
      },
      "profiles": [
        "web"
      ]
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "sync": "node scripts/sync-office-data.mjs",
    "check": "node scripts/sync-office-data.mjs --check",
    "prepublishOnly": "npm run check && npm test && npm run e2e && npm run rehearse && npm run fault",
    "test": "node --test \"test/*.test.mjs\"",
    "e2e": "node scripts/e2e-w1.mjs",
    "rehearse": "node scripts/rehearse.mjs",
    "fault": "node scripts/fault-injection.mjs",
    "probe": "node scripts/platform-probe.mjs"
  },
  "main": "./index.js"
}
